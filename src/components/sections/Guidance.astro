---
import type { Content } from '../../content/schema';
import { ANCHORS, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
  t: Content;
}

const { lang, t } = Astro.props;
const { guidance } = t;
---

<section id={ANCHORS.guidance} class="section" data-section="Guidance" data-lang={lang}>
  <div class="container layout">
    <header class="head">
      <p class="eyebrow">{guidance.eyebrow}</p>
      <h2 class="heading">{guidance.title}</h2>
      <p class="lead">{guidance.intro}</p>
    </header>

    <div class="body">
      <ol role="list" class="steps">
        {
          guidance.steps.map((s, i) => (
            <li class="step">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div class="txt">
                <h3 class="subheading">{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="card note">
        <p>{guidance.care}</p>
        <p class="ui disclaimer">{guidance.disclaimer}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: clamp(40px, 6vw, 64px);
  }
  .head {
    display: grid;
    gap: 20px;
    max-width: 640px;
    align-content: start;
  }
  .steps {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding-block: 32px;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--muted);
  }
  .txt {
    display: grid;
    gap: 10px;
  }
  .note {
    display: grid;
    gap: 16px;
    margin-top: 40px;
  }
  .disclaimer {
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1.1fr;
      gap: 80px;
      align-items: start;
    }
    .head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>
